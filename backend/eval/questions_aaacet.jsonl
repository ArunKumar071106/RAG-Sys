// Sample evaluation questions for the real AAACET site.
// expected_url_patterns are URL substrings the answer page is EXPECTED to contain.
// They were written before the site could be crawled from the build environment:
// after your first crawl, check `python -m rag.cli search "<question>"` and adjust
// each pattern to the actual official page URL.
{"question": "What undergraduate engineering courses does AAACET offer?", "expected_url_patterns": ["re:course|department|programme|academic"]}
{"question": "What is the admission procedure at AAACET?", "expected_url_patterns": ["admission"]}
{"question": "Which university is AAACET affiliated to?", "expected_url_patterns": ["re:about|affiliat|profile"]}
{"question": "What is the TNEA counselling code of AAACET?", "expected_url_patterns": ["re:admission|counsel|about"]}
{"question": "Tell me about placements and recruiters at AAACET", "expected_url_patterns": ["placement"]}
{"question": "Does the college have hostel facilities?", "expected_url_patterns": ["re:hostel|facilit"], "expected_image_patterns": ["re:hostel"]}
{"question": "What facilities does the library have?", "expected_url_patterns": ["re:library|facilit"]}
{"question": "Is transport available for students?", "expected_url_patterns": ["re:transport|facilit|bus"]}
{"question": "Who is the principal of AAACET?", "expected_url_patterns": ["re:principal|about|administration"]}
{"question": "What is the contact address and phone number of the college?", "expected_url_patterns": ["contact"]}
{"question": "Tell me about the Computer Science and Engineering department", "expected_url_patterns": ["re:cse|computer"]}
{"question": "Is AAACET NAAC accredited?", "expected_url_patterns": ["re:naac|accredit|about|iqac"]}
{"question": "What is the weather on the moon today?", "answerable": false}
