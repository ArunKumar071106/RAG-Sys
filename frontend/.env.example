# Base URL of the FastAPI backend (no trailing slash). Leave empty when the frontend
# is served from the same origin as the API (e.g. behind a reverse proxy) or in
# `npm run dev`, which forwards /api to http://127.0.0.1:8000 (VITE_DEV_API_PROXY).
VITE_API_BASE_URL=http://localhost:8000
# Request timeout for chat calls, in milliseconds.
VITE_CHAT_TIMEOUT_MS=90000
