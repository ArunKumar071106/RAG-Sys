# Copy to .env and adjust. Never commit the real .env (it is git-ignored).

# ---------------------------------------------------------------- secrets
# Hosted LLM (Claude) for grounded answers and optional image descriptions.
# Leave empty to run in "extractive" mode (answers quote the website directly).
ANTHROPIC_API_KEY=
# Bearer token for POST /api/admin/reindex. Empty disables admin endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Only for a secured Qdrant server / Qdrant Cloud.
QDRANT_API_KEY=

# ---------------------------------------------------------------- storage
DATA_DIR=./data

# ---------------------------------------------------------------- crawling
CRAWL_START_URLS=https://aaaenggcoll.ac.in/
CRAWL_ALLOWED_DOMAINS=aaaenggcoll.ac.in,www.aaaenggcoll.ac.in
CRAWL_MAX_PAGES=400
CRAWL_MAX_DEPTH=4
CRAWL_DELAY_SECONDS=1.0
CRAWL_CONCURRENCY=2
CRAWL_OBEY_ROBOTS=true
CRAWL_INCLUDE_PDFS=true

# ---------------------------------------------------------------- chunking
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=40

# ---------------------------------------------------------------- images
# Extra hosts allowed for image downloads (e.g. a CDN), comma separated.
IMAGE_ALLOWED_DOMAINS=
IMAGE_MIN_DIMENSION=80
OCR_ENGINE=rapidocr            # rapidocr | tesseract | none
VISION_ENABLED=false           # true = describe images with the vision model (needs ANTHROPIC_API_KEY)
VISION_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=bge-m3      # bge-m3 (needs backend/requirements-ml.txt) | hashing (offline, lexical only)
EMBEDDING_MODEL=BAAI/bge-m3    # HF model id or a local path to the downloaded model
EMBEDDING_DEVICE=cpu           # cpu | cuda
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------- vector store
# Empty QDRANT_URL = embedded local Qdrant in DATA_DIR/qdrant (single process).
QDRANT_URL=
QDRANT_TEXT_COLLECTION=aaacet_text
QDRANT_IMAGE_COLLECTION=aaacet_images

# ---------------------------------------------------------------- retrieval
RETRIEVAL_TOP_K=6
SEMANTIC_CANDIDATES=30
BM25_CANDIDATES=30
RRF_K=60
IMAGE_TOP_K=4
TEXT_MIN_SEMANTIC_SCORE=0.25
IMAGE_MIN_SEMANTIC_SCORE=0.35
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------------------------------------------- LLM
LLM_PROVIDER=anthropic         # anthropic | extractive
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low                 # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_SERVER_FALLBACKS=true

# ---------------------------------------------------------------- API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=1000
LOG_LEVEL=INFO
