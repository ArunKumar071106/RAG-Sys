# Copy to .env and adjust. Never commit the real .env (it is git-ignored).

# ---------------------------------------------------------------- secrets
# The AI that writes the answers: Google Gemini (free tier), a key from https://aistudio.google.com/apikey
# Leave empty to run in "extractive" mode (answers quote the website directly).
GEMINI_API_KEY=
# Claude instead (optional; also used for AI image descriptions): a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Bearer token for POST /api/admin/reindex. Empty disables admin endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Only for a secured Qdrant server / Qdrant Cloud.
QDRANT_API_KEY=

# ---------------------------------------------------------------- storage
DATA_DIR=./data

# ---------------------------------------------------------------- crawling
CRAWL_START_URLS=https://aaaenggcoll.ac.in/
CRAWL_ALLOWED_DOMAINS=aaaenggcoll.ac.in,www.aaaenggcoll.ac.in
CRAWL_MAX_PAGES=400
CRAWL_MAX_DEPTH=4
CRAWL_DELAY_SECONDS=1.0
CRAWL_CONCURRENCY=2
CRAWL_OBEY_ROBOTS=true
CRAWL_INCLUDE_PDFS=true

# ---------------------------------------------------------------- chunking
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=40

# ---------------------------------------------------------------- images
# Extra hosts allowed for image downloads (e.g. a CDN), comma separated.
IMAGE_ALLOWED_DOMAINS=
IMAGE_MIN_DIMENSION=80
OCR_ENGINE=rapidocr            # rapidocr | tesseract | none
VISION_ENABLED=false           # true = describe images with the vision model (needs ANTHROPIC_API_KEY)
VISION_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=bge-m3      # bge-m3 (needs backend/requirements-ml.txt) | fastembed | hashing (offline, lexical only)
                               # bge-m3 falls back to fastembed, then hashing, when it cannot load
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5  # BAAI/bge-base-en-v1.5 is a little better but ~3x slower to index on a CPU;
                               # intfloat/multilingual-e5-large understands Tamil questions too (2.2 GB, much slower)
EMBEDDING_MODEL=BAAI/bge-m3    # HF model id or a local path to the downloaded model
EMBEDDING_DEVICE=cpu           # cpu | cuda
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------- vector store
# Empty QDRANT_URL = embedded local Qdrant in DATA_DIR/qdrant (single process).
QDRANT_URL=
QDRANT_TEXT_COLLECTION=aaacet_text
QDRANT_IMAGE_COLLECTION=aaacet_images
# Qdrant server / Cloud uploads: seconds per request and points per upload (lower both on a slow connection)
QDRANT_TIMEOUT=120
QDRANT_UPSERT_BATCH=16

# ---------------------------------------------------------------- retrieval
RETRIEVAL_TOP_K=6
SEMANTIC_CANDIDATES=30
BM25_CANDIDATES=30
RRF_K=60
IMAGE_TOP_K=4
TEXT_MIN_SEMANTIC_SCORE=0.25
IMAGE_MIN_SEMANTIC_SCORE=0.35
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Department names as the website writes them (comma-separated); type-ahead suggests questions about each.
# DEPARTMENTS=Artificial Intelligence and Data Science,Computer Science and Engineering,Mechanical Engineering

# ---------------------------------------------------------------- LLM
LLM_PROVIDER=gemini            # gemini (needs GEMINI_API_KEY) | anthropic (Claude, needs ANTHROPIC_API_KEY) | extractive
GEMINI_MODEL=gemini-flash-latest  # the alias follows Google's current Flash model
LLM_MODEL=claude-opus-5-5      # the Claude model, when LLM_PROVIDER=anthropic
LLM_EFFORT=low                 # low | medium | high | xhigh | max
LLM_MAX_TOKENS=16000
LLM_SERVER_FALLBACKS=true

# ---------------------------------------------------------------- daily report
# Questions the website could not answer and 👍/👎 ratings are saved in DATA_DIR/feedback (phone numbers
# and emails masked) and emailed once a day. Gmail: SMTP_USER is the Gmail address and SMTP_PASSWORD an
# app password (Google account > Security > 2-Step Verification > App passwords), not the normal password.
# Test with: python -m rag.cli feedback-report --test-email
FEEDBACK_ENABLED=true
REPORT_EMAIL_TO=               # who gets the report, comma separated
REPORT_HOUR=18                 # the server's local time
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- API
# other sites that host the chat page (the page served by the backend itself needs none)
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=1000
LOG_LEVEL=INFO
